# Copy to /etc/default/haproxy-backend-monitor and edit values.

SOCKET=/run/haproxy/haproxy.sock
INTERVAL=5
WINDOW=600
# Stop after N seconds; 0 = run forever.
# DURATION=0

# Warning thresholds
FLAP_THRESHOLD=3
CHKFAIL_THRESHOLD=2
CHKDOWN_THRESHOLD=1
RESP5XX_THRESHOLD=5
ALERT_COOLDOWN=300

# Alert
ALERT_COOLDOWN=300
CRITICAL_ALERT_COOLDOWN=120

# Critical thresholds
CRITICAL_FLAP_THRESHOLD=6
CRITICAL_CHKFAIL_THRESHOLD=4
CRITICAL_CHKDOWN_THRESHOLD=2
CRITICAL_5XX_THRESHOLD=20
CRITICAL_ALERT_COOLDOWN=120

# Output behavior
ONLY_BAD=1

# Telegram
TELEGRAM_BOT_TOKEN=AAAAA:AA-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
# Replace with your real chat id (e.g. -1001234567890). Never commit real values.
TELEGRAM_CHAT_ID=-1001234567890
